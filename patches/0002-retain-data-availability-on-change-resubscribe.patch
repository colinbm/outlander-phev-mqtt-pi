 func (m *mqttClient) topic(topic string) string {
 	return fmt.Sprintf("%s%s", m.prefix, topic)
 }
 
+// setAvailable publishes phev/available (retained) only when the value changes.
+func (m *mqttClient) setAvailable(state string) {
+	m.availMu.Lock()
+	defer m.availMu.Unlock()
+	if m.available == state {
+		return
+	}
+	m.available = state
+	m.client.Publish(m.topic("/available"), 0, true, state)
+}
+
+// onMqttConnect runs on every (re)connect to the broker: paho drops
+// subscriptions with a clean session, and the broker may have published our
+// "offline" will while we were away, so re-subscribe and re-assert availability.
+func (m *mqttClient) onMqttConnect(c mqtt.Client) {
+	for _, t := range []string{"/set/#", "/connection", "/settings/#"} {
+		if token := c.Subscribe(m.topic(t), 0, nil); token.Wait() && token.Error() != nil {
+			log.Errorf("Error subscribing to %s: %v", m.topic(t), token.Error())
+		}
+	}
+	m.availMu.Lock()
+	state := m.available
+	m.availMu.Unlock()
+	if state != "" {
+		c.Publish(m.topic("/available"), 0, true, state)
+	}
+}
+
