[Unit]
Description=phev2mqtt - Outlander PHEV to MQTT gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/phev2mqtt/env
ExecStart=/usr/local/bin/phev2mqtt client mqtt
Restart=always
RestartSec=30
DynamicUser=yes
StateDirectory=phev2mqtt
Environment=HOME=/var/lib/phev2mqtt
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
